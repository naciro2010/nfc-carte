# Fastfile — iOS deployment for NFC Carte
#
# Lanes:
#   - beta     : builds a signed IPA and uploads it to TestFlight
#   - release  : submits the current build to the App Store for review
#   - match    : syncs signing certificates + provisioning profiles via `match`
#
# All secrets are injected from environment variables (GitHub Actions secrets).
# See DEPLOY.md for the full list.

default_platform(:ios)

FLUTTER_BIN = ENV["FLUTTER_BIN"] || "flutter"
XCODE_WORKSPACE = "../ios/Runner.xcworkspace"
XCODE_SCHEME    = "Runner"
EXPORT_METHOD   = "app-store"

platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Sync code signing via match (read-only on CI)"
  lane :sync_signing do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
      in_house: false
    )
    match(
      type: "appstore",
      readonly: ENV["CI"] ? true : false,
      app_identifier: ENV["IOS_BUNDLE_ID"],
      git_url: ENV["MATCH_GIT_URL"],
      git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTH"],
      storage_mode: "git"
    )
  end

  desc "Build & upload to TestFlight"
  lane :beta do
    sync_signing

    # Bump build number to commit count so we never collide with TestFlight.
    build_num = sh("git rev-list --count HEAD").strip.to_i
    sh("#{FLUTTER_BIN} pub get")
    sh("#{FLUTTER_BIN} build ios --release --no-codesign --build-number=#{build_num}")

    build_app(
      workspace: XCODE_WORKSPACE,
      scheme: XCODE_SCHEME,
      export_method: EXPORT_METHOD,
      clean: true,
      output_directory: "../build/ios/ipa",
      output_name: "nfc_carte-#{build_num}.ipa",
      xcargs: "-allowProvisioningUpdates"
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Internal build"
    )
  end

  desc "Submit the latest TestFlight build to the App Store"
  lane :release do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true
    )

    deliver(
      submit_for_review: true,
      automatic_release: true,
      force: true, # Skip HTML preview
      skip_screenshots: true,
      skip_metadata: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: true,
        export_compliance_is_exempt: true,
        export_compliance_contains_third_party_cryptography: false,
        export_compliance_contains_proprietary_cryptography: false
      },
      precheck_include_in_app_purchases: false
    )
  end
end
